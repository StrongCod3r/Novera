+.code-line-numbers { flex:none; min-width:38px; padding:8px 8px 18px 6px; border-right:0; color:var(--code-line-number); text-align:right; font:11.5px/1.6 "SFMono-Regular",Consolas,"Liberation Mono",monospace; user-select:none; background:var(--code-bg); }
 .code-line-numbers.hidden { display:none; }
 .code-line-numbers span { display:block; height:1.6em; }
-.code-editor-stack { position:relative; flex:1; min-width:0; overflow:hidden; background:#202020; }
+.code-editor-stack { position:relative; flex:1; min-width:0; overflow:hidden; background:var(--code-bg); }
 .code-highlight,.code-input { margin:0; width:100%; min-height:104px; padding:6px 26px 24px 26px; border:0; font:12.5px/1.6 "SFMono-Regular",Consolas,"Liberation Mono",monospace; tab-size:2; }
-.code-highlight { position:absolute; inset:0; overflow:hidden; pointer-events:none; color:#eeeeee; background:transparent; white-space:pre; }
+.code-highlight { position:absolute; inset:0; overflow:hidden; pointer-events:none; color:var(--code-text); background:transparent; white-space:pre; }
 .code-highlight code { font:inherit; white-space:inherit; }
-.code-input { position:relative; z-index:1; display:block; resize:none; outline:none; overflow-x:auto; overflow-y:hidden; field-sizing:content; color:transparent; caret-color:#f0f0f0; background:transparent; white-space:pre; -webkit-text-fill-color:transparent; }
-.code-input::selection { background:rgba(124,58,237,.35); }
+.code-input { position:relative; z-index:1; display:block; resize:none; outline:none; overflow-x:auto; overflow-y:hidden; field-sizing:content; color:transparent; caret-color:var(--code-caret); background:transparent; white-space:pre; -webkit-text-fill-color:transparent; }
+.code-input::selection { background:var(--code-selection); }
 .code-editor-wrap.wrap .code-highlight,.code-editor-wrap.wrap .code-highlight code,.code-editor-wrap.wrap .code-input { white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word; }
 .code-editor-wrap.wrap .code-input { overflow-x:hidden; }
-.code-token.comment { color:#6a9955; }
-.code-token.string { color:#ce9178; }
-.code-token.number { color:#b5cea8; }
-.code-token.keyword { color:#c586c0; }
-.code-token.type { color:#4ec9b0; }
-.code-token.function { color:#dcdcaa; }
-.code-token.tag { color:#569cd6; }
-.code-token.attr { color:#9cdcfe; }
-.code-token.operator { color:#d7ba7d; }
-.code-token.directive { color:#c586c0; }
+.code-token.comment { color:var(--code-token-comment); }
+.code-token.string { color:var(--code-token-string); }
+.code-token.number { color:var(--code-token-number); }
+.code-token.keyword { color:var(--code-token-keyword); }
+.code-token.type { color:var(--code-token-type); }
+.code-token.function { color:var(--code-token-function); }
+.code-token.tag { color:var(--code-token-tag); }
+.code-token.attr { color:var(--code-token-attr); }
+.code-token.operator { color:var(--code-token-operator); }
+.code-token.directive { color:var(--code-token-directive); }
 .mermaid-preview-icon { width:14px; height:14px; fill:none; stroke:currentColor; stroke-width:1.7; stroke-linecap:round; stroke-linejoin:round; }
-.mermaid-preview { min-height:140px; padding:17px 20px 20px; border-top:1px solid #333; background:#181818; overflow:auto; }
+.mermaid-preview { min-height:140px; padding:17px 20px 20px; border-top:1px solid var(--code-preview-border); background:var(--code-preview-bg); overflow:auto; }
 .mermaid-preview.hidden { display:none; }
-.mermaid-preview-status { min-height:22px; display:flex; align-items:center; justify-content:center; padding:22px 12px; color:#888; font:11.5px/1.5 Inter,system-ui,sans-serif; text-align:center; }
+.mermaid-preview-status { min-height:22px; display:flex; align-items:center; justify-content:center; padding:22px 12px; color:var(--code-muted); font:11.5px/1.5 Inter,system-ui,sans-serif; text-align:center; }
 .mermaid-preview-status.hidden { display:none; }
-.mermaid-preview-status.error { color:#e58f8f; }
+.mermaid-preview-status.error { color:var(--code-error); }
 .mermaid-render { display:flex; justify-content:center; min-width:0; overflow:auto; }
 .mermaid-render svg { display:block; max-width:100%; height:auto; margin:auto; }
 .code-options-sep { height:1px; background:var(--border); margin:4px 0; }
